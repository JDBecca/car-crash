;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Car Crash"
run/main_scene="uid://ybsdmbinvjwu"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
run/max_fps=60
config/icon="res://icon.svg"

[display]

window/size/viewport_width=256
window/size/viewport_height=224
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=0
window/ios/allow_high_refresh_rate=false

[dotnet]

project/assembly_name="Car Crash"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

